# Optional: Restricted Google Cloud API key for Gemini translation of custom recipes.
VITE_GEMINI_API_KEY=""

# Firebase Configuration (Required for cloud sync & family auth)
# Obtain these from your Firebase Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Comma-separated list of approved Google account emails allowed to access the vault
# Example: "your_email@gmail.com,mom_email@gmail.com,dad_email@gmail.com"
VITE_FAMILY_EMAILS=""

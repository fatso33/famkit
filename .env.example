# Optional: reCAPTCHA Enterprise site key registered with Firebase App Check. Protects recipe
# translation (Firebase AI Logic). This is a public site key, not a secret.
VITE_RECAPTCHA_SITE_KEY=""

# Firebase Configuration (Required for cloud sync & family auth)
# Obtain these from your Firebase Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Who may sign in is not set here: see "Add family members" in README.md (Firestore family_members).

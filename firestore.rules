rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with an email the sign-in provider has verified, so nobody can claim someone
    // else's address.
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // On the family list: family_members/{email}, the email in lowercase. The list is kept in the
    // Firebase console only; nobody can change it from the app.
    function isFamily() {
      return isVerified() &&
        exists(/databases/$(database)/documents/family_members/$(myEmail()));
    }

    // Each person may look up only their own entry, so the app can tell whether they're family
    // without anyone being able to read the list.
    match /family_members/{email} {
      allow get: if isVerified() && myEmail() == email;
      allow list, create, update, delete: if false;
    }

    // The family member who added a recipe owns it. Records from before owners existed have none.
    function ownedByMe(data) {
      return data.get('ownerEmail', '').lower() == myEmail();
    }

    // Any family phone may finish a background translation, so writing only the translation
    // fields is allowed on anyone's recipe.
    function onlyTranslation() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['translations', 'sourceLanguage']);
    }

    match /recipes/{recipeId} {
      allow read: if isFamily();
      // New recipes must be recorded as added by the person saving them.
      allow create: if isFamily() && ownedByMe(request.resource.data);
      // Only the owner edits (and can't hand the recipe to someone else).
      allow update: if isFamily() && (
        (ownedByMe(resource.data) && ownedByMe(request.resource.data)) ||
        onlyTranslation()
      );
      // Recipes are never erased from the app.
      allow delete: if false;

      // Earlier versions: a backup only the recipe's owner can read or add to. Once written, a
      // version can't be changed or deleted by anyone, the owner included.
      match /versions/{versionId} {
        function ownsRecipe() {
          return ownedByMe(get(/databases/$(database)/documents/recipes/$(recipeId)).data);
        }
        allow read, create: if isFamily() && ownsRecipe();
        allow update, delete: if false;
      }
    }

    // The recipes' photos, one to a document, under a random id: recipes, their versions and
    // drafts point at them ("photo:<id>"). Any family member may add one: its JPEG's bytes and
    // nothing else, at most 900 KB (the app's own are 100-250 KB). Once written, a photo is never
    // changed or deleted, so every version that points at it keeps it; writing the very same
    // photo again (a save retried offline) is allowed and changes nothing. Read one by one only.
    match /photos/{photoId} {
      function isPhoto(data) {
        return data.keys().hasOnly(['jpeg']) && data.jpeg is bytes &&
          data.jpeg.size() <= 900 * 1024;
      }
      allow get: if isFamily();
      allow list: if false;
      allow create: if isFamily() && photoId.matches('^[0-9a-f]{32}$') &&
        isPhoto(request.resource.data);
      allow update: if isFamily() && request.resource.data == resource.data;
      allow delete: if false;
    }

    // Makes: what family members made from the recipes, each with a photo. The maker owns theirs.
    // Anyone may heart one (giving or taking back only their own heart), and any family phone may
    // finish its background translation.
    match /makes/{makeId} {
      function hearts(data) {
        return data.get('hearts', {});
      }
      function onlyMyHeart() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hearts']) &&
          hearts(request.resource.data).diff(hearts(resource.data)).affectedKeys()
            .hasOnly([myEmail()]) &&
          hearts(request.resource.data).get(myEmail(), true) == true;
      }
      allow read: if isFamily();
      // Added by the person saving it, under its own id, with no hearts yet.
      allow create: if isFamily() && ownedByMe(request.resource.data) &&
        request.resource.data.get('id', '') == makeId &&
        !('hearts' in request.resource.data);
      // Only the maker edits it (keeping it theirs, and leaving its hearts as they are).
      allow update: if isFamily() && (
        (ownedByMe(resource.data) && ownedByMe(request.resource.data) &&
          hearts(request.resource.data) == hearts(resource.data)) ||
        onlyTranslation() ||
        onlyMyHeart()
      );
      // Makes are never erased from the app.
      allow delete: if false;
    }

    // Drafts: recipes and edits a family member is still writing, kept under their own email
    // (in lowercase). Only they can read, save or discard them.
    match /drafts/{email}/recipes/{draftId} {
      allow read, write: if isFamily() && myEmail() == email;
    }
  }
}
